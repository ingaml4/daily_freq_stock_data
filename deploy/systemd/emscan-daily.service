# 由 emscan-daily.timer 触发（默认 15:32 + 17:15 各一次）：自愈同步 + 放量扫描 + 指标信号 + 报告
#
# 安装：
#   sudo mkdir -p /etc/emscan
#   sudo install -m 600 /dev/null /etc/emscan/emscan.env      # 然后编辑，写入 MAIRUI_LICENCE=...
#   sudo cp deploy/systemd/emscan-daily.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now emscan-daily.timer
#   systemctl list-timers emscan-daily.timer ; journalctl -u emscan-daily -n 50
[Unit]
Description=emscan A股日频放量扫描 + 指标信号
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 按自己的路径改
WorkingDirectory=/home/jumpsrv/daily-freq-stock-data
# 只把证书放在这个文件里（600 权限），不要写进 git
EnvironmentFile=-/etc/emscan/emscan.env
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
# 15:32 那次会自动跳过"当天还没发布"的技术指标，17:15 那次补齐；两次都是幂等的。
ExecStart=/usr/bin/python3 -m emscan run
# 单次任务最长 3 小时（300 次/分的档位跑全市场大约 1 小时）
TimeoutStartSec=10800
Nice=10

[Install]
WantedBy=multi-user.target
