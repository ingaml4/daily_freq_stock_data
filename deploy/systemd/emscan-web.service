# 常驻网页端：四个查询按钮（放量 / MACD金叉 / KDJ金叉 / 布林下轨）
#
# 安装：
#   sudo mkdir -p /etc/emscan
#   sudo install -m 600 /dev/null /etc/emscan/emscan.env     # 写 MAIRUI_LICENCE=... 和 EMSCAN_WEB_TOKEN=...
#   sudo cp deploy/systemd/emscan-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now emscan-web
#   systemctl status emscan-web ; journalctl -u emscan-web -n 30
#
# 建议只监听 127.0.0.1，由 nginx/Caddy 反代出去（TLS + 认证 + gzip）。
# 如果确实要直接对外，把 host 改成 0.0.0.0 并在 emscan.env 里设置 EMSCAN_WEB_TOKEN。
[Unit]
Description=emscan 网页端（A股日频信号查询）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jumpsrv/daily-freq-stock-data
EnvironmentFile=-/etc/emscan/emscan.env
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m emscan web --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
